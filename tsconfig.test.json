{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false
  },
  "include": ["src/js/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts"]
}
